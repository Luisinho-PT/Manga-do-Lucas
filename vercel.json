{
  "version": 2,
  "buildCommand": "bash build.sh",
  "functions": {
    "manga/wsgi.py": {
      "runtime": "@vercel/python@3.12",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "manga/wsgi.py"
    }
  ]
}
