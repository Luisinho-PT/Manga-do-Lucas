{
  "version": 2,
  "builds": [
    {
      "src": "manga/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9",
        "buildCommand": "bash build.sh"
      }
    },
    {
      "src": "staticfiles",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "manga/wsgi.py"
    }
  ]
}