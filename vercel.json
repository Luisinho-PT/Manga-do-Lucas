{
  "builds": [
    {
      "src": "manga/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
    }
  ],
  "routes": [
    {
      "src": "/staticfiles/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "manga/wsgi.py"
    }
  ],
    "scripts": {
    "postbuild": "python manage.py sync_changelogs"
  }
}